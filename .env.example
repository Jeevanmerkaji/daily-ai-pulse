# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored, so your secrets never get committed.

# Postgres connection string from your Neon project (Dashboard > Connection Details).
# Looks like: postgresql://user:password@ep-something.neon.tech/dbname?sslmode=require
DATABASE_URL=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# From https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address emails are sent from. Until you verify your own domain
# in Resend, you can use their shared testing address: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# A random secret string you make up yourself (e.g. run `openssl rand -hex 32`).
# Used to make sure only Vercel's real cron scheduler can trigger the daily job,
# not just anyone who finds the URL.
CRON_SECRET=

# The public URL of your site once deployed (used to build unsubscribe links
# in emails). For local testing this can stay as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (TEST MODE ONLY for now — use your test-mode secret key, which
# always starts with sk_test_, never sk_live_). From
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Identifies your Pro subscription's price in test mode. Create a test-mode
# Product + recurring Price in the Stripe Dashboard (Product catalog), then
# copy its Price ID (starts with price_).
STRIPE_PRO_PRICE_ID=

# Verifies that webhook requests really came from Stripe, not an impostor.
# For local dev, the Stripe CLI prints this when you run `stripe listen`
# (see README). In production, copy it from your webhook endpoint's
# settings in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Optional. From your Sentry project's Settings > Client Keys (DSN). If unset,
# error reporting silently no-ops (errors still go to console.error) — safe
# to leave blank for local dev.
SENTRY_DSN=
